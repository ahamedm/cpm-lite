# Local API configuration. Copy to apps/api/.env.
CPM_API_PORT=8080
CPM_API_HOST=0.0.0.0
CPM_OLTP_DUCKDB_PATH=data/cpm_lite_oltp.duckdb
CPM_ANALYTICS_DUCKDB_PATH=data/cpm_lite_preview.duckdb
CPM_API_JWT_SECRET=replace-with-a-long-random-secret
CPM_API_JWT_ISSUER=cpm-lite
CPM_API_SERVICE_TOKEN=service-token
CPM_API_CORS_ORIGINS=http://localhost:5173
CPM_API_ENGINE_VERSION=0.1.0
CPM_API_DATASET_SNAPSHOT=gold:current
CPM_API_MAX_JOB_ATTEMPTS=3
CPM_API_IDEMPOTENCY_TTL_HOURS=168
# Cube refresh: set CPM_CUBE_API_SECRET to the same value as cube/.env CUBEJS_API_SECRET.
CPM_CUBE_REFRESH_ENABLED=true
CPM_CUBE_URL=http://localhost:4000
CPM_CUBE_API_SECRET=replace-with-the-cube-api-secret
CPM_CUBE_REFRESH_POLL_MS=5000
CPM_CUBE_REFRESH_MAX_ATTEMPTS=5
# Schema snapshot transport: file (default, single host) or valkey (multi-pod).
CPM_CUBE_SCHEMA_STORE=file
# CPM_VALKEY_URL=redis://localhost:6379
# CPM_VALKEY_KEY_PREFIX=cpm:cube-schema
# CPM_VALKEY_SCHEMA_TTL_SECONDS=0
# Optional override for the promoted-model manifest (default cube/model/promoted-models.json).
# CPM_CUBE_PROMOTED_MANIFEST=cube/model/promoted-models.json
LOG_LEVEL=info
