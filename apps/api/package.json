{
  "name": "@cpm-lite/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CPM Lite Thin Orchestrator API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "promote-cube-schema": "tsx scripts/promote-cube-schema.ts",
    "token": "tsx scripts/mint-token.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@duckdb/node-api": "2.0.0-r.1",
    "@fastify/cors": "11.4.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.28.19",
    "kysely-duckdb": "0.4.0",
    "openapi-types": "12.1.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
