# Local Cube Core configuration. Copy this file to cube/.env and set a secret.
# Production identity is Microsoft Entra ID; these values are for local development.
CUBEJS_DEV_MODE=false
CUBEJS_DB_TYPE=duckdb
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
CUBEJS_SCHEDULED_REFRESH_TIMER=false
CUBEJS_TELEMETRY=false
CUBEJS_API_SECRET=replace-with-a-long-random-secret
CPM_DUCKDB_PATH=../data/cpm_lite.duckdb
PORT=4000
